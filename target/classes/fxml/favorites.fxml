<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ir.ac.aut.secondhand.frontend.controller.FavoritesController"
            styleClass="content-view">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="24" right="28" bottom="16" left="28"/></padding>
            <VBox>
                <Label text="Favorites" styleClass="page-title"/>
                <Label fx:id="stateLabel" styleClass="muted-label"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll">
            <content>
                <FlowPane fx:id="favoritesPane" hgap="18" vgap="18">
                    <padding><Insets top="10" right="28" bottom="30" left="28"/></padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ir.ac.aut.secondhand.frontend.controller.LoginController"
            styleClass="auth-root">
    <center>
        <HBox alignment="CENTER" spacing="50">
            <padding><Insets top="40" right="60" bottom="40" left="60"/></padding>
            <VBox spacing="14" maxWidth="430" styleClass="auth-intro">
                <Label text="Second Hand" styleClass="brand-title"/>
                <Label text="Buy and sell used items safely, search advertisements, chat with sellers and manage everything from one JavaFX application."
                       wrapText="true" styleClass="brand-subtitle"/>
<!--                <Separator/>-->
<!--                <Label text="Default administrator" styleClass="section-title"/>-->
<!--                <Label text="Username: admin" styleClass="muted-label"/>-->
<!--                <Label text="Password: adminPass" styleClass="muted-label"/>-->
            </VBox>
            <VBox spacing="14" maxWidth="390" styleClass="auth-card">
                <Label text="Sign in" styleClass="page-title"/>
                <Label text="Enter your username and password" styleClass="muted-label"/>
                <Label text="Username"/>

                <TextField fx:id="usernameField" promptText="username" onAction="#onLogin"/>
                <Label text="Password"/>
                <PasswordField fx:id="passwordField" promptText="password" onAction="#onLogin"/>
                <Button fx:id="loginButton" text="Sign in" onAction="#onLogin" maxWidth="Infinity" styleClass="primary-button"/>

                <Label fx:id="statusLabel" styleClass="muted-label"/>
                <Separator/>
                <Button text="Create a new account" onAction="#onOpenRegister" maxWidth="Infinity" styleClass="secondary-button"/>
                <Button text="← Back to guest mode" onAction="#onBack" maxWidth="Infinity" styleClass="secondary-button"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

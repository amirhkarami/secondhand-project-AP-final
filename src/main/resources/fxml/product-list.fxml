<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ir.ac.aut.secondhand.frontend.controller.ProductListController"
            styleClass="content-view">
    <top>
        <VBox spacing="14">
            <padding><Insets top="24" right="28" bottom="16" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Advertisements" styleClass="page-title"/>
                    <Label text="Search active advertisements returned by the backend" styleClass="muted-label"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Refresh" onAction="#onRefresh" styleClass="secondary-button"/>
            </HBox>
            <GridPane hgap="10" vgap="10" styleClass="filter-panel">
                <columnConstraints>
                    <ColumnConstraints percentWidth="27"/>
                    <ColumnConstraints percentWidth="17"/>
                    <ColumnConstraints percentWidth="17"/>
                    <ColumnConstraints percentWidth="13"/>
                    <ColumnConstraints percentWidth="13"/>
                    <ColumnConstraints percentWidth="13"/>
                </columnConstraints>
                <TextField fx:id="keywordField" promptText="Keyword" GridPane.columnIndex="0" GridPane.rowIndex="0" onAction="#onSearch"/>
                <ComboBox fx:id="categoryCombo" promptText="Category" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <ComboBox fx:id="cityCombo" promptText="City" maxWidth="Infinity" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="minPriceField" promptText="Min price" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <TextField fx:id="maxPriceField" promptText="Max price" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                <ComboBox fx:id="sortCombo" promptText="Sort" maxWidth="Infinity" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                <HBox spacing="8" GridPane.columnIndex="0" GridPane.columnSpan="6" GridPane.rowIndex="1">
                    <Button text="Search" onAction="#onSearch" styleClass="primary-button"/>
                    <Button text="Clear filters" onAction="#onClear" styleClass="secondary-button"/>
                </HBox>
            </GridPane>
            <Label fx:id="stateLabel" styleClass="muted-label"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll">
            <content>
                <FlowPane fx:id="productsPane" hgap="18" vgap="18" prefWrapLength="900">
                    <padding><Insets top="10" right="28" bottom="30" left="28"/></padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
